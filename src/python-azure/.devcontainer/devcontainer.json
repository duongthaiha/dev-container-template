{
  "name": "Python Azure",
  "image": "ghcr.io/duongthaiha/python-azure-devcontainer:${templateOption:imageTag}",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-azurecli",
        "ms-azuretools.azd",
        "eamodio.gitlens"
      ]
    }
  },
  "postCreateCommand": "echo \"Microsoft Skills available: $(ls ~/.copilot/skills 2>/dev/null | wc -l) under ~/.copilot/skills/\"",
  "remoteUser": "vscode",
  "runArgs": [
    "--add-host=host.docker.internal:host-gateway"
  ]
}
